<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (scripts/check-widgets-device.mjs): what the shell needs to reach without touching the phone's home screen. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- RN's quick capture dialog is not exported; this alias lets the check start it as the widget and the tile do. -->
        <activity-alias
            android:name="${applicationId}.DebugQuickCapture"
            android:exported="true"
            android:targetActivity="tech.dongdongbh.mindwtr.androidwidget.QuickCaptureActivity" />
        <!-- Hosts one of this app's widgets in its own AppWidgetHost, so the check draws and taps a widget without a launcher. -->
        <activity
            android:name="tech.dongdongbh.mindwtr.pilot.WidgetHostActivity"
            android:exported="true"
            android:label="Widget host" />
    </application>
</manifest>
