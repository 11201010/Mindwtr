<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The network state core's sync reads (HostNetwork.kt), as RN's expo-network does. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- RN's network security config (apps/mobile/plugins/android-network-security-config.js). -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="Mindwtr Native Dev"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/Theme.NativeDev">

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />

        <!-- Settings › Data › Share log hands files/logs/mindwtr.log to the share sheet; nothing else is reachable. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostics_paths" />
        </provider>

        <!-- singleTask, as RN's MainActivity: a link, share or note sent while the app runs reaches onNewIntent in the app's
             own task. Not exported: only its alias below, with RN's filters, starts it from outside the app. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="Mindwtr Native Dev"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <!-- RN's component name, <applicationId>.MainActivity: home-screen icons, pinned shortcuts and widgets launch it
             (inventory section 6). It carries RN's entry points (plugins/android-app-shortcuts.js, app.json's share intent):
             the launcher, links of the build's scheme, text shares (files come with the attachments pass), Google Assistant's
             notes, and the app shortcuts. Every input is untrusted: core reads it (resolveNativeEntryPoint). -->
        <activity-alias
            android:name="${applicationId}.MainActivity"
            android:exported="true"
            android:label="Mindwtr Native Dev"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${urlScheme}" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.actions.CREATE_NOTE" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.VOICE" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/mindwtr_shortcuts" />
        </activity-alias>

        <!-- RN's capture intent (plugins/android-widget.js), under RN's class name so an automation that names it keeps working.
             Exported on purpose: it checks the exact action, the string extras, the device-local token and the text bounds
             before it queues anything, and then starts CoreWork. -->
        <receiver
            android:name="tech.dongdongbh.mindwtr.androidwidget.CaptureIntentReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="tech.dongdongbh.mindwtr.action.CAPTURE" />
            </intent-filter>
        </receiver>

        <!-- RN's context automation receiver and its two filters (plugins/android-manifest-fixes.js), under RN's class name.
             Exported as in RN: core reads the trigger (runContextAutomation), and nothing is written. -->
        <receiver
            android:name="tech.dongdongbh.mindwtr.contextautomation.ContextAutomationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="tech.dongdongbh.mindwtr.action.ACTIVATE_CONTEXT" />
                <action android:name="tech.dongdongbh.mindwtr.action.DEACTIVATE_CONTEXT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="tech.dongdongbh.mindwtr.action.ACTIVATE_CONTEXT" />
                <action android:name="tech.dongdongbh.mindwtr.action.DEACTIVATE_CONTEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="mindwtr" />
            </intent-filter>
        </receiver>
    </application>

    <!-- RN's app lock asks BiometricPrompt (AppLock.kt), as expo-local-authentication's manifest allows. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- RN's notifications (app.json's permissions): the context automation notification (CoreNotifications.kt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
